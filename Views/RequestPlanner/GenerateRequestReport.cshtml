
@{
    ViewBag.Title = "GenerateRequestReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h4>Generate Request Report</h4>
<form method="get" action="@Url.Action("DownloadRequestReport", "RequestPlanner")">
    <div class="form-group">
        <div>
            <div class="col-md-3">
                <b>From Date:</b><input type="date" name="StartDate" value="StartDate" id="StartDate"/>
            </div>
            <div class="col-md-3">
                <b>To Date:</b><input type="date" name="EndDate" value="EndDate" id="EndDate" />
            </div>
        </div>
        <div>
            <button type="submit" class="btn btn-default">Download</button>
        </div>

    </div>
</form>
