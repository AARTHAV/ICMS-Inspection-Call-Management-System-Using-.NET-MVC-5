        function FillAgency() {
            var agency = document.getElementById("hiddenAgencyName");
            $.ajax({
                url: '/ICMS/RequestPlanner/GetAgencyInfromation',
                type: "GET",
                dataType: "JSON",
                data: { RequestType: 0 },
                success: function (data) {
                    var markup = "<option value=''>-Select Agency-</option>";
                    $("#AgcyID").html(""); // clear before appending new list
                    $.each(data, function (i, item) {
                        if (agency.value == data[i].Text) {
                            markup += "<option selected value=" + data[i].Value + ">" +
                                data[i].Text + "</option>";
                        }
                        else {
                            markup += "<option value=" + data[i].Value + ">" +
                                data[i].Text + "</option>";
                        }

                        //$("#FrgNo").append($('<option></option>').text(data[i].Text).val(data[i].Value ));
                    });
                    /*$("#FrgNo").html(markup).show();*/
                    $("#AgcyID").append(markup).show();
                    $('#DivExtenralRequestInformation').show();
                },
                error: function () {
                    alert("Data Not Found");
                }
            });
        }
        function CheckInspectorAvaliable(InspectorNo, StartDate, EndDate, InsectorName, PlnID) {
            //<input type="hidden" name="IsInternalInspectorAvaliable" id="IsInternalInspectorAvaliable"/>
            $.ajax({
                async: false,
                url: '/ICMS/RequestPlanner/CheckInspectorAvaliable',
                type: "GET",
                dataType: "JSON",
                data: { inspectorNo: InspectorNo, startDate: StartDate, endDate: EndDate, PlanID: PlnID },
                success: function (data) {
                    if (data != "0") {
                        alert(InsectorName + " Inspector already assigned")
                        document.getElementById("IsInternalInspectorAvaliable").value = 'true';
                    }
                    else {
                        document.getElementById("IsInternalInspectorAvaliable").value = 'false';
                    }
                    /*$("#FrgNo").html(markup).show();*/
                },
                error: function () {
                    document.getElementById("IsInternalInspectorAvaliable").value = 'true';
                    alert("Data Not Found");
                }
            });
        }
