    <script type="text/javascript">
        function CheckDateValidation() {
            var PlnID = document.getElementById('PlnID').value;
            var IsParallel = document.getElementById('IsParallel').value;
            var ReqStatus = document.getElementById('objInspReqModel_0__RqStatus').value;
            if (PlnID != 0 && (ReqStatus == "Replanned" || ReqStatus == "Assigned" || ReqStatus == "Planned & not allocated")) {
                var ResnID = document.getElementById('ResnID');
                var InspRemark = document.getElementById('InspRemark');
                if (ResnID.value == "") {
                    alert("Please select reason");
                    return false;
                }
                if (InspRemark.value == "") {
                    alert("Please Enter Remarks");
                    return false;
                }
            }
            try {
                var plnStart = document.getElementById('PlnStart');
                var PlnEnd = document.getElementById('PlnEnd');
                var OfrDttm = document.getElementById('objInspReqModel_0__OfrDttm');

                if (Date.parse(plnStart.value) < Date.parse(OfrDttm.value)) {
                    alert('Please select Internal Plan Start After Offer Date');
                    return false;
                }
                else if (Date.parse(PlnEnd.value) <= Date.parse(plnStart.value)) {
                    alert('Please select Internal Plan End Date After Plan Start Date');
                    return false;
                }
            }
            catch {

            }

            try {
                var Name_of_Employees = document.getElementById('Name_of_Employees');
                if (Name_of_Employees.length == 1) {
                    alert('Please select inspector');
                    return false;
                }
                var inspector = "";
                for (var i = 1; i < Name_of_Employees.length; i++) {
                    inspector = inspector + Name_of_Employees[i].value + ",";
                    CheckInspectorAvaliable(Name_of_Employees[i].value, plnStart.value, PlnEnd.value, Name_of_Employees[i].text, PlnID);
                    var IsInternalInspectorAvaliable = document.getElementById("IsInternalInspectorAvaliable");
                    //alert(IsInternalInspectorAvaliable.value);
                    if (IsInternalInspectorAvaliable.value == 'true') {
                        return false;
                    }
                }
                document.getElementById('tempValue').value = inspector;
            }
            catch {

            }
            var IsParallel = document.getElementById('IsParallel').value;
            var PlnID = document.getElementById('PlnID').value;
            var ReqType = document.getElementById("objInspReqModel_0__RqTypeName");
            if (IsParallel == 1 || PlnID != 0 || ReqType.value == "External") {
                var ExtenalRquestPlnStart = document.getElementById('ExtenalRquestPlnStart');
                var ExtenalRquestPlnEnd = document.getElementById('ExtenalRquestPlnEnd');
                var InternalRquestPlnEnd = document.getElementById('PlnEnd');
                var ExtenalRemark = document.getElementById('ExternalPlnRemark');
                var AgcyID = document.getElementById('AgcyID');
                var plnStart = document.getElementById('PlnStart');
                var OfrDttm = document.getElementById('objInspReqModel_0__OfrDttm');
                if (AgcyID.value != "") {
                    if (Date.parse(ExtenalRquestPlnStart.value) == Date.parse(InternalRquestPlnEnd.value)) {
                        alert('External Plan Start and Internal Plan End should not be Clas');
                        return false;
                    }
                    if (Date.parse(ExtenalRquestPlnStart.value) <= Date.parse(InternalRquestPlnEnd.value)) {
                        alert('Please select External Plan Start After End Date of Interal Plan ' + InternalRquestPlnEnd.value);
                        return false;
                    }
                    else if (Date.parse(ExtenalRquestPlnEnd.value) <= Date.parse(ExtenalRquestPlnStart.value)) {
                        alert('Please select External Plan End Date After External Plan Start Date');
                        return false;
                    }
                    if (ExternalPlnRemark.value.trim().length == 0) {
                        alert('Please Enter External Request Remark');
                        return false;
                    }
                    if (PlnID != 0) {
                        var External_Name_of_Employees = document.getElementById('External_Name_of_Employees');
                        if (External_Name_of_Employees.length == 1) {
                            alert('Please select inspector');
                            return false;
                        }
                    }
                }
                else {
                    if (ReqType.value == "External") {
                        alert('Please Select Agency');
                        return false;
                    }

                }
                //alert(OfrDttm.value.format('DD-MMM-YYYY'););

            }

            try {
                var External_Name_of_Employees = document.getElementById('External_Name_of_Employees');
                var Externalinspector = "";
                for (var i = 1; i < External_Name_of_Employees.length; i++) {
                    Externalinspector = Externalinspector + External_Name_of_Employees[i].value + ",";
                    try {
                        CheckInspectorAvaliable(External_Name_of_Employees[i].value, ExtenalRquestPlnStart.value, ExtenalRquestPlnEnd.value, External_Name_of_Employees[i].text, PlnID);
                    }
