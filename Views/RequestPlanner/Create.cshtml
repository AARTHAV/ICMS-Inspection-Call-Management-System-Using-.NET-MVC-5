@model ICMS.Models.RequestPlannerDetailsModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*<h2>Create Planning</h2>*@


@using (Html.BeginForm("Create", "RequestPlanner", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <div style="color:red">@ViewBag.RecordException</div>
        <div style="color:red">@ViewBag.RecordNotExist</div>
        <div style="color:red">@TempData["RecordException"]</div>
        @if (ViewBag.RecordNotExist == null)
        {

            <h4 style="visibility:hidden">Plan Request:@Model.objInspReqModel[0].RqID</h4>
            <h4><div style="float: right; color: blue">Status:@Html.DisplayFor(model => model.objInspReqModel[0].RqStatus)</div></h4>
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.ActionLink("Close", "Index", null, new { @class = "btn btn-primary btn-large" })
            <input type="hidden" name="ExternalInspector" id="ExternalInspector" value="@ViewBag.selectedInspector" />
            <input type="hidden" name="InternalInspector" id="InternalInspector" value="@ViewBag.selectedInteralInspector" />
            <div class="card" id="DivBusiness" runat="server" visible="false">

                <div class="card-header">
                    <b>Initiator Information</b>
                </div>
                <div class="card-body">
                    <h5 class="card-title"></h5>
                    <div class="form-group">
                        <div>
                            @Html.LabelFor(model => model.objInspReqModel[0].RqNo, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.HiddenFor(model => model.objInspReqModel[0].RqID)
                                @Html.HiddenFor(model => model.objInspReqModel[0].RqStatus)
                                @Html.HiddenFor(model => model.PlnID)
                                @Html.HiddenFor(model => model.IsParallel)
                                <input type="hidden" name="IsInternalInspectorAvaliable" id="IsInternalInspectorAvaliable" />
                                @*@Html.HiddenFor(model => model.objInspReqModel[0].OfrDttm, new { htmlAttributes = new { @id = "hidnOffer", @Value = Model.objInspReqModel[0].OfrDttm.Value.ToString("yyyy-MM-ddTHH:MM"), @class = "form-control" } })*@
                                @Html.EditorFor(model => model.objInspReqModel[0].RqNo, new { htmlAttributes = new { @readonly = "readonly", @style = "width:35%;float:left;color:blue", @class = "form-control" } })
                                @Html.EditorFor(model => model.objInspReqModel[0].RqRevNo, new { htmlAttributes = new { @readonly = "readonly", @style = "width:35%;color:blue", @class = "form-control" } })
                            </div>
                        </div>
                        <div>

                            @Html.LabelFor(model => model.objInspReqModel[0].RqRegDttm, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3" style="margin-top: 5px;">
                                @Model.objInspReqModel[0].RqRegDttm
                                @*@Html.EditorFor(model => model.objInspReqModel[0].RqRegDttm, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })*@
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div>
                            @Html.LabelFor(model => model.objInspReqModel[0].PrjNo, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.EditorFor(model => model.objInspReqModel[0].PrjNo, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
                            </div>

                        </div>
                        <div>
                            @Html.LabelFor(model => model.objInspReqModel[0].FrgNo, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.EditorFor(model => model.objInspReqModel[0].FrgNo, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
                            </div>

                        </div>
                    </div>
                    <div class="form-group">
                        <div>
                            @Html.LabelFor(model => model.objInspReqModel[0].RqType, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.EditorFor(model => model.objInspReqModel[0].RqTypeName, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
                                @*@Html.DropDownList("RqType", (IEnumerable<SelectListItem>)ViewBag.RequestType, "Select Request Type", new { @class = "form-control", @onchange = "FillAgency()" })*@
                            </div>

                        </div>
                        <div>
                            @Html.LabelFor(model => model.objInspReqModel[0].StageName, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.EditorFor(model => model.objInspReqModel[0].StageName, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <div>
                            @Html.LabelFor(model => model.objInspReqModel[0].LcName, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.EditorFor(model => model.objInspReqModel[0].LcName, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
                            </div>
                        </div>
                        <div>
                            @Html.LabelFor(model => model.objInspReqModel[0].Remark, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.EditorFor(model => model.objInspReqModel[0].Remark, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div>
                            @Html.LabelFor(model => model.objInspReqModel[0].RqRegBy, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.EditorFor(model => model.objInspReqModel[0].RqRegBy, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
                            </div>
                        </div>

                        <div>
                            @Html.LabelFor(model => model.objInspReqModel[0].OfrDttm, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3" style="margin-top: 5px;">
                                @Html.EditorFor(model => model.objInspReqModel[0].OfrDttm, new { htmlAttributes = new { @readonly = "readonly", @Value = Model.objInspReqModel[0].OfrDttm.Value.ToString("yyyy-MM-ddTHH:mm"), @type = "datetime-local", @required = false, @class = "form-control" } })
                            </div>

                        </div>
                    </div>
                    <div class="form-group">
                        <div>
                            @Html.LabelFor(model => model.objInspReqModel[0].RqDpcd, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.EditorFor(model => model.objInspReqModel[0].RqDpcd, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            <div class="form-group">
                <div style="margin-left:15px">
                    @if (Model.PlnID == 0)
                    {
                        <input type="button" id="ShowExtenralRequest" name="ShowExtenralRequest" data-bs-target="#profile" class="btn btn-primary btn-large" value="Raised Parallel External Request" onclick="ShowParallelRequestInformation()" />
                        <input type="button" id="HideExtenralRequest" name="HideExtenralRequest" class="btn btn-danger btn-large" value="Cancel Parallel External Request" onclick="HideParallelRequestInformation()" />
                    }
                </div>
            </div>


            <div class="container"></div>
            <div id="exTab1" class="card">
                <ul class="nav nav-pills">
                    <li id="InternalTab">
                        <a href="#1a" data-toggle="tab">Internal Request</a>
                    </li>
                    <li id="ExternalTab">
                        <a href="#2a" data-toggle="tab">External Request</a>
                    </li>
                </ul>

                <div class="tab-content clearfix">
                    <div class="tab-pane" id="1a">
                        @if (Model.objInspReqModel[0].RqTypeName == "Internal")
                        {
                            <div class="form-group">
                                <div>
                                    @Html.LabelFor(model => model.PlnStart, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-3">
                                        @Html.EditorFor(model => model.PlnStart, new { htmlAttributes = new { @Value = Model.PlnStart.Value.ToString("yyyy-MM-ddTHH:mm"), @class = "form-control", @type = "datetime-local" } })
                                        @Html.ValidationMessageFor(model => model.PlnStart, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div>
                                    @Html.LabelFor(model => model.PlnEnd, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-3">
                                        @Html.EditorFor(model => model.PlnEnd, new { htmlAttributes = new { @class = "form-control", @Value = Model.PlnEnd.Value.ToString("yyyy-MM-ddTHH:mm"), @type = "datetime-local" } })
                                        @Html.ValidationMessageFor(model => model.PlnEnd, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                            </div>

                            <div class="form-group">

                                <div>
                                    @Html.LabelFor(model => model.PlnBy, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-3">
                                        @Html.EditorFor(model => model.PlnBy, new { htmlAttributes = new { @Value = Session["EmpName"].ToString(), @readonly = "readonly", @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.PlnBy, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div>
                                    @Html.LabelFor(model => model.PlnRemark, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        @Html.EditorFor(model => model.PlnRemark, new { htmlAttributes = new { @class = "form-control", @required = "required", @onblur = "CopyRemarkToExternal()" } })
                                        @Html.ValidationMessageFor(model => model.PlnRemark, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                            </div>

                            <div class="form-group">

                                <div>
                                    @Html.LabelFor(model => model.FilePath, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-3">

                                        @*<input type="file" name="UploadedFile" multiple="multiple" accept="application/pdf, application/vnd.ms-excel,image/gif, image/jpeg" />*@
                                        @Html.TextBoxFor(model => model.UploadedFile, new
                                        {
                                            type = "file",
                                            multiple = "multiple",
                                       onchange = "return checkFileUploadExt(this);"
                                        })
                                        @Html.ValidationMessageFor(m => m.UploadedFile, "", new { @class = "text-danger" })
                                    </div>

                                </div>

                            </div>


                            <div class="form-group">

                                <div>
                                    @Html.LabelFor(model => model.lstEmployee, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-4">


                                        <div style="float:left">
                                            @Html.ListBoxFor(model => model.EmpPsNo, (ViewBag.Employee as SelectList), new { @class = "listbox", @style = "width:250px" })
                                        </div>

                                        <div style="float:left">

                                            <div>

                                                <input type="button" value=">>" name="btnAddEmployee" id="btnAddEmployee" onclick="return addEmployee()" />

                                            </div>

                                            <div>

                                                <input type="button" value="<<" name="btnRemoveEmployee" id="btnRemoveEmployee" onclick="return removeEmployee()" />

                                            </div>

                                        </div>


                                    </div>

                                </div>

                                <div>
                                    @Html.DropDownListFor(model => model.Name_of_Employees, new SelectList(""), "--Selected Insecptor--", new { @size = 4, @class = "form-control;listbox", @multiple = "multiple", @style = "width:250px" })
                                    @*<select id="Name_of_Employees" name="Name_of_Employees" Name="Name_of_Employees" Size="5"></select>*@
                                    @*<input type="hidden" name="tempValue" id="tempValue"/>*@
                                    @Html.HiddenFor(o => o.tempValue, new { Name = "tempValue" })
                                    
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="form-group">
                                <div>
                                    @Html.LabelFor(model => model.PlnStart, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-3" style="margin-top: 5px;">
                                        @Html.EditorFor(model => model.PlnStart, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", @Value = Model.PlnStart.Value.ToString("yyyy-MM-ddTHH:mm"), @type = "datetime-local" } })
                                    </div>
                                </div>
                                <div>
                                    @Html.LabelFor(model => model.PlnEnd, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-3" style="margin-top: 5px;">
                                        @Html.EditorFor(model => model.PlnEnd, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", @Value = Model.PlnEnd.Value.ToString("yyyy-MM-ddTHH:mm"), @type = "datetime-local" } })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div>
                                    @Html.LabelFor(model => model.PlnBy, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-3">
                                        @Html.EditorFor(model => model.PlnBy, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
                                    </div>
                                </div>
                                <div>
                                    @Html.LabelFor(model => model.PlnDpcd, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-3">
                                        @Html.EditorFor(model => model.PlnDpcd, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
                                    </div>
                                </div>

                            </div>
                            <div class="form-group">
                                <div>
                                    @Html.LabelFor(model => model.PlnDttm, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-3">
                                        @Html.EditorFor(model => model.PlnDttm, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
                                    </div>

                                </div>
                                <div>
                                    @Html.LabelFor(model => model.PlnRemark, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-3">
                                        @Html.EditorFor(model => model.PlnRemark, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
                                    </div>
                                </div>

                            </div>
                        }
                    </div>
                    <div class="tab-pane" id="2a">
                        @if (Model.ExtenalRquestPlnStart.HasValue)
                        {
                            <div class="form-group">

                                <div>
                                    @Html.LabelFor(model => model.ExtenalRquestPlnStart, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-3">
                                        @Html.EditorFor(model => model.ExtenalRquestPlnStart, new { htmlAttributes = new { @Value = Model.ExtenalRquestPlnStart.Value.ToString("yyyy-MM-ddTHH:mm"), @class = "form-control", @type = "datetime-local" } })
                                        @*@Html.ValidationMessageFor(model => model.ExtenalRquestPlnStart, "", new { @class = "text-danger" })*@
                                    </div>
                                    <div>
                                        @Html.LabelFor(model => model.ExtenalRquestPlnEnd, htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-3">
                                            @Html.EditorFor(model => model.ExtenalRquestPlnEnd, new { htmlAttributes = new { @class = "form-control", @Value = Model.ExtenalRquestPlnEnd.Value.ToString("yyyy-MM-ddTHH:mm"), @type = "datetime-local" } })
                                            @*@Html.ValidationMessageFor(model => model.ExtenalRquestPlnEnd, "", new { @class = "text-danger" })*@
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="form-group">

                                <div>
                                    @Html.LabelFor(model => model.PlnBy, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-3">
                                        @Html.EditorFor(model => model.PlnBy, new { htmlAttributes = new { @Value = Session["EmpName"].ToString(), @readonly = "readonly", @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.PlnBy, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div>
                                    @Html.LabelFor(model => model.ExternalPlnRemark, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        @Html.EditorFor(model => model.ExternalPlnRemark, new { htmlAttributes = new { @class = "form-control", @required = "required" } })
                                        @*@Html.ValidationMessageFor(model => model.ExternalPlnRemark, "", new { @class = "text-danger" })*@
                                    </div>
                                </div>
                            </div>
                            <div id="DivExtenralRequestInformation">

                                <div class="form-group">

                                    <div>
                                        @Html.LabelFor(model => model.AgcyID, htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-3">
                                            @*@Html.EditorFor(model => model.FrgNo, new { htmlAttributes = new { @class = "form-control" } })*@
                                            @Html.DropDownListFor(model => model.AgcyID,
    new SelectList(Enumerable.Empty<SelectListItem>(), "AgID", "AgName"),
    new { @class = "form-control" })
                                            <input type="hidden" name="hiddenAgencyName" id="hiddenAgencyName" value="@Model.AgencyName" />
                                            @*@Html.ValidationMessageFor(model => model.AgcyID, "", new { @class = "text-danger" })*@
                                            @*@Html.DropDownListFor("FrgNo", (IEnumerable<SelectListItem>)ViewBag.Forging, "Select Forging", new { @class = "form-control" })*@
                                        </div>

                                    </div>

                                </div>

                                <div class="form-group">

                                    <div>
                                        @Html.LabelFor(model => model.FilePath, htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-3">

                                            @*<input type="file" name="UploadedExternalFile" multiple="multiple" accept="application/pdf, application/vnd.ms-excel,image/gif, image/jpeg" />*@
                                            @Html.TextBoxFor(model => model.UploadedExternalFile, new { type = "file", multiple = "multiple", onchange = "return checkExternalFileUploadExt(this);" })
                                            @Html.ValidationMessageFor(m => m.UploadedExternalFile, "", new { @class = "text-danger" })
                                        </div>

                                    </div>

                                </div>
                                <div class="form-group">

                                    <div>
                                        @Html.LabelFor(model => model.lstEmployee, htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-4">
                                            <div style="float:left">
                                                @Html.ListBoxFor(model => model.ExternalEmpPsNo, (ViewBag.Employee as SelectList), new { @class = "listbox", @style = "width:250px" })
                                            </div>
                                            <div style="float:left">
                                                <div>
                                                    <input type="button" value=">>" name="btnAddEmployee" id="btnExternalAddEmployee" onclick="return addExternalEmployee()" />
                                                </div>
                                                <div>
                                                    <input type="button" value="<<" name="btnRemoveEmployee" id="btnExternalRemoveEmployee" onclick="return removeExternalEmployee()" />
                                                </div>

                                            </div>
                                        </div>


                                        <div>
                                            @Html.DropDownListFor(model => model.External_Name_of_Employees, new SelectList(""),"--Selected Insecptor--", new { @size = 4, @class = "form-control;listbox", @multiple = "multiple", @style = "width:250px" })
                                            @*<select id="Name_of_Employees" name="Name_of_Employees" Name="Name_of_Employees" Size="5"></select>*@
                                            @*<input type="hidden" name="tempValue" id="tempValue"/>*@
                                            @Html.HiddenFor(o => o.ExternaltempValue, new { Name = "ExternaltempValue" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="card" id="DivShowReason" runat="server" visible="false">
                <div class="card-header">
                    <b>Reason Information</b>
                </div>
                <div class="card-body">
                    <h5 class="card-title"></h5>
                    <div class="form-group">
                        <div>
                            @Html.LabelFor(model => model.ResnID, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-3">
                                @Html.DropDownList("ResnID", (IEnumerable<SelectListItem>)ViewBag.Reason, "Select Reason", new { @class = "form-control" })
                            </div>

                        </div>
                        <div>
                            @Html.LabelFor(model => model.InspRemark, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.EditorFor(model => model.InspRemark, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div style="clear:both"></div>
            <div class="form-group">
                <div class="col-md-10">
                    <input type="submit" value="Assign" id="btnAssign" name="btnAssign" class="btn btn-primary btn-large"
                           onclick="return CheckDateValidation();" />
                    @*<input type="button" value="Assign1" id="btnAssign1" name="btnAssign1" class="btn btn-primary btn-large"
                           onclick="return CheckDateValidation();" />*@
                    @Html.ActionLink("Close", "Index", null, new { @class = "btn btn-primary btn-large" })
                    @if (Model.objInspReqModel[0].RqTypeName == "External")
                    {
                        @Html.ActionLink("View Internal Request", "Create", new { id = Model.objInspReqModel[0].RqID, data = Model.ID }, new { @class = "btn btn-primary btn-large", target = "_blank" })
                    }
                </div>
            </div>

            <div>Assigned Inspector:</div>
            <table class="table table-striped">
                <tr>
                    <th cope="col">PsNo</th>
                    <th cope="col">Inspector Name</th>
                    <th cope="col">Type</th>
                    <th cope="col">Assigned Datetime</th>
                    <th cope="col"></th>
                </tr>
                @if (Model.listAssignInspector != null)
                {
                    for (int k = 0; k < Model.listAssignInspector.Count; k++)
                    {
                        <tr>
                            <td scope="row">
                                @Model.listAssignInspector[k].InsPsNo
                            </td>
                            <td scope="row">@Model.listAssignInspector[k].InsBy</td>
                            <td scope="row">
                                @Model.listAssignInspector[k].TypeOfInspector
                            </td>
                            <td scope="row">@Model.listAssignInspector[k].InsDttm</td>
                            <td scope="row">
                                @Html.ActionLink("Remove", "DeleteAssignInsp", new { id = @Model.listAssignInspector[k].InsID, data = Model.objInspReqModel[0].RqID },
    new { onclick = "return confirm('Are you sure you wish to delete assiged this employee?');" })
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td>Not assign Inspector yet</td>
                    </tr>
                }
            </table>

            <div>List of documents:</div>
            <table class="table table-striped">
                <tr>
                    <th cope="col">Document Name</th>
                    @*<th cope="col">Department</th>*@
                    <th cope="col">Upload By</th>
                    <th cope="col">Upload Date</th>
                    <th cope="col"></th>
                </tr>
                @if (Model.lstDocument != null)
                {
                    for (int i = 0; i < Model.lstDocument.Count; i++)
                    {
                        <tr>
                            <td scope="row">@Model.lstDocument[i].DocName</td>
                            @*<td scope="row">@Model.PlnDpcd</td>*@
                            <td scope="row">@Model.lstDocument[i].UpldBy</td>
                            <td scope="row">@Model.lstDocument[i].UpldDttm</td>
                            <td scope="row">
                                @Html.ActionLink("Remove", "DeleteDoc", new { id = Model.lstDocument[i].DocID, data = Model.objInspReqModel[0].RqID },
            new { onclick = "return confirm('Are you sure you wish to delete this document?');" })

                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td scope="row">No Document avaliable</td>
                    </tr>
                }
            </table>
        }
    </div>

}


