@model ICMS.Models.RequestPlannerDetailsModel

@{
    ViewBag.Title = "View";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h4>View Planning</h4>

<div class="form-horizontal">
    <div style="color:red">@ViewBag.RecordException</div>
    <div style="color:red">@ViewBag.RecordNotExist</div>
    <div style="color:red">@TempData["RecordException"]</div>
    @if (ViewBag.RecordNotExist == null)
    {

        <h4><div style="float: right; color: blue">Status:@Html.DisplayFor(model => model.objInspReqModel[0].RqStatus)</div></h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.ActionLink("Close", "Index", null, new { @class = "btn btn-primary btn-large" })
