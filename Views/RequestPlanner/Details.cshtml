                                        @Html.EditorFor(model => model.PlnRemark, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
                                    </div>
                                </div>

                            </div>
                        </div>


                    </div>
                    <div class="tab-pane" id="2a">
                        <div class="form-group">
                            <div>
                                @Html.LabelFor(model => model.ExtenalRquestPlnStart, htmlAttributes: new { @class = "control-label col-md-2" })
