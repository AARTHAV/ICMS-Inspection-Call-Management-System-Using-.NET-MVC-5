    <link rel="stylesheet" href="~/Scripts/nice-select.css" type="text/css">
    <link rel="stylesheet" href="~/Scripts/magnific-popup.css" type="text/css">
    <link rel="stylesheet" href="~/Scripts/jquery-ui.min.css" type="text/css">
    <link rel="stylesheet" href="~/Scripts/owl.carousel.min.css" type="text/css">
