    <style>
        .loginbutton {
            font-size: 16px;
            color: #323232;
            font-weight: 700;
            display: block;
            padding: 5px 0;
            position: relative;
            text-decoration: none;
        }

            .loginbutton:hover {
                font-size: 16px;
                color: #323232;
                font-weight: 700;
                display: block;
                padding: 5px 0;
                position: relative;
                text-decoration: none;
            }

        }
    </style>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
