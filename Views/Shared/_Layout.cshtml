    @*<script type="text/javascript" src="http://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>*@

    <!-- qTip -->
    @*<script type="text/javascript" src="http://cdnjs.cloudflare.com/ajax/libs/qtip2/3.0.3/jquery.qtip.min.js"></script>*@

    <!-- Full Calendar -->
    @*<script type="text/javascript" src="http://cdnjs.cloudflare.com/ajax/libs/fullcalendar/2.9.1/fullcalendar.min.js"></script>*@
    @Scripts.Render("~/bundles/Script-calendar")
    @RenderSection("scripts", required: false)
</body>
</html>
