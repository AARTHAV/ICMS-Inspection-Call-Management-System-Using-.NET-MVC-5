    <!-- Offcanvas Menu Begin -->
    @if (string.IsNullOrEmpty(Session["EmpPsNo"] as string))
    {
        Response.Redirect(Url.Action("../Login/Index"));
    }
    <div class="offcanvas-menu-overlay"></div>
    <div class="offcanvas-menu-wrapper">
        <div class="offcanvas__search">
            <i class="fa fa-search search-switch"></i>
        </div>
        <nav class="offcanvas__menu mobile-menu">
            <ul>
                @*<li class="active"><a href="./index.html">Home</a></li>
                    <li><a href="./about.html">Initiator</a></li>
                *@
                <li><a href="./services.html">Planner</a></li>
                <li><a href="./blog.html">Head</a></li>
                <li><a href="./blog.html">Inspector</a></li>
                <li>
                    <a href="#">Masters</a>
                    <ul class="dropdown">
                        <li>@Html.ActionLink("Agency", "Index", "Agency")</li>
                        <li>@Html.ActionLink("About", "About", "Home")</li>
                        @if (string.IsNullOrEmpty(Session["EmpPsNo"] as string))
                        {
                            <li>@Html.ActionLink("Initiator", "Index", "Initiator")</li>
                            <li>@Html.ActionLink("Planner", "Index", "RequestPlanner")</li>
                            <li>@Html.ActionLink("Inspector", "Index", "Inspector")</li>
                            <li>@Html.ActionLink("Approval Request", "Index", "HOD")</li>
                        }
                        else
                        {
                            if (Session["Role"].ToString() == "INT" || Session["Role"].ToString() == "QCP")
                            {
                                <li>@Html.ActionLink("Initiator", "Index", "Initiator")</li>
                            }
                            if (Session["Role"].ToString() == "QCP")
                            {
                                <li>@Html.ActionLink("Planner", "Index", "RequestPlanner")</li>
                            }
                            if (Session["Role"].ToString() == "QCI")
                            {
                                <li>@Html.ActionLink("Inspector", "Index", "Inspector")</li>
                            }
                            if (Session["Role"].ToString() == "HOD")
                            {
                                <li>@Html.ActionLink("Approval Request", "Index", "HOD")</li>
                            }
                        }


                        @*
                            <li>@Html.ActionLink("User Role", "Index", "UserRole")</li>
                            <li>@Html.ActionLink("Stage", "Index", "Stage")</li>
                            <li>@Html.ActionLink("Status", "Index", "Status")</li>
                            <li>@Html.ActionLink("User", "Index", "User")</li>
                            <li>@Html.ActionLink("Agency Employee", "Index", "Tpi")</li>
                        *@
                    </ul>
                </li>

            </ul>
        </nav>
        <div id="mobile-menu-wrap"></div>
        <ul class="offcanvas__widget">
            <li>
                <i class="fa fa-map-marker"></i>
                @if (!string.IsNullOrEmpty(Session["Role"] as string))
                {
                    <div>Role : @Session["Role"].ToString() </div>
                    <div>EmailID : @Session["EmployeeEmail"].ToString() </div>
                }

            </li>
            <li>
                <i class="fa fa-phone"></i>
                @if (!string.IsNullOrEmpty(Session["Role"] as string))
                {
                    <div>Department : @Session["EmployeeDeparment"].ToString() </div>
                    <div>Employee Name : @Session["EmpName"].ToString() </div>
                }
            </li>
            @*<li><i class="fa fa-envelope"></i>Info@colorlib.com</li>
            *@
        </ul>
        <div class="offcanvas__language">
            <img src="~/img/flag.png" alt="">
            <span>English</span>
            <i class="fa fa-angle-down"></i>
            <ul>
                <li><a href="#">English</a></li>
                
            </ul>
        </div>
    </div>
    <!-- Offcanvas Menu End -->
    <!-- Header Section Begin -->
        <header class="header" >
            <div class="header__top">
                <div class="container" style="margin-top: -3.8%; height: 60px">
                    <!--style="margin-top: -3.8%; height: 60px">-->
                    <div class="row">
                        <div class="col-lg-9">
                            <ul class="header__top__widget" style="padding: 0px 0 0px; margin-top: 10px">
                                <li>
                                    @if (!string.IsNullOrEmpty(Session["Role"] as string))
                                    {
                                        <div>Role : @Session["Role"].ToString() </div>
                                        <div>EmailID : @Session["EmployeeEmail"].ToString() </div>
                                    }

                                </li>
                                <li>
                                    @if (!string.IsNullOrEmpty(Session["Role"] as string))
                                    {
                                        <div>Department : @Session["EmployeeDeparment"].ToString() </div>
                                        <div>Employee Name : @Session["EmpName"].ToString() </div>
                                    }

                                </li>
                                <li>
                                    <i class="fa fa-phone"></i>

                                </li>
                            </ul>
                        </div>

                        <div class="col-lg-3">
                            <div class="header__top__language">
                                @if (string.IsNullOrEmpty(Session["Role"] as string))
                                {
                                    <span>@Html.ActionLink("Login", "Index", "Login", null, new { @class = "loginbutton" })</span>
                                }
                                else
                                {
                                    <span>@Html.ActionLink("Logout", "Logout", "User", null, new { @class = "loginbutton" })</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="header__nav" style="padding: 0px 0px 0px; text-align: left">
                            <nav class="header__menu">
                                <ul>
                                    @*<li class="active">@Html.ActionLink("Home", "Index", "Home")</li>
                                    <li>@Html.ActionLink("About", "About", "Home")</li>
                                    *@
                                    @if (string.IsNullOrEmpty(Session["EmpPsNo"] as string))
                                    {
                                        <li>@Html.ActionLink("Initiator", "Index", "Initiator")</li>
                                        <li>@Html.ActionLink("Planner", "Index", "RequestPlanner")</li>
                                        <li>@Html.ActionLink("Inspector", "Index", "Inspector")</li>
                                        <li>@Html.ActionLink("Approval Request", "Index", "HOD")</li>
                                    }
                                    else
                                    {
                                        if (Session["Role"].ToString() == "INT" || Session["Role"].ToString() == "QCP")
                                        {
                                            <li>@Html.ActionLink("Initiator", "Index", "Initiator")</li>
                                        }
                                        if (Session["Role"].ToString() == "QCP")
                                        {
                                            <li>@Html.ActionLink("Planner", "Index", "RequestPlanner")</li>
                                            <li>
                                                <a href="#">Operations</a>
                                                <ul class="dropdown">
                                                    <li>@Html.ActionLink("Group Request", "Index", "PlannerExternalRequest")</li>
                                                    <li>@Html.ActionLink("Rejected Request", "Rejected", "PlannerExternalRequest")</li>
                                                    <li>@Html.ActionLink("Print Request", "Print", "PlannerExternalRequest")</li>
                                                </ul>
                                            </li>
                                            <li>
                                                <a href="#">Reports</a>
                                                <ul class="dropdown">
                                                    <li>@Html.ActionLink("Request Report", "GenerateRequestReport", "RequestPlanner")</li>
                                                    <li>@Html.ActionLink("Calender Report", "GenerateCalenderReport", "RequestPlanner")</li>
                                                </ul>
                                            </li>
                                            <li>
                                                <a href="#">Masters</a>
                                                <ul class="dropdown">
                                                    <li>@Html.ActionLink("Agency", "Index", "Agency")</li>
                                                    <li>@Html.ActionLink("Maintain Email Addr.", "Index", "MaintainEmail")</li>
                                                    <li>@Html.ActionLink("Email Template", "Index", "EmailTemplate")</li>
                                                    <li>@Html.ActionLink("Location", "Index", "Location")</li>
                                                    <li>@Html.ActionLink("Reason", "Index", "Reason")</li>

                                                    <li>@Html.ActionLink("User Role", "Index", "UserRole")</li>
                                                    <li>@Html.ActionLink("Stage", "Index", "Stage")</li>
                                                    @*<li>@Html.ActionLink("Status", "Index", "Status")</li>*@
                                                    <li>@Html.ActionLink("User", "Index", "User")</li>
                                                    <li>@Html.ActionLink("Agency Employee", "Index", "Tpi")</li>
                                                </ul>
                                            </li>
                                        }
                                        if (Session["Role"].ToString() == "QCI" || Session["Role"].ToString() == "QCP")
                                        {
                                            <li>@Html.ActionLink("Inspector", "Index", "Inspector")</li>
                                        }
                                        if (Session["Role"].ToString() == "HOD")
                                        {
                                            <li>@Html.ActionLink("Approval Request", "Index", "HOD")</li>
                                        }
                                    }



                                    @*
                                    <li>
                                        <a href="#">Masters</a>
                                        <ul class="dropdown">
                                            <li>@Html.ActionLink("Agency", "Index", "Agency")</li>
                                            <li>@Html.ActionLink("Email Template", "Index", "EmailTemplate")</li>
                                            <li>@Html.ActionLink("Location", "Index", "Location")</li>
                                            <li>@Html.ActionLink("Reason", "Index", "Reason")</li>

                                            <li>@Html.ActionLink("User Role", "Index", "UserRole")</li>
                                            <li>@Html.ActionLink("Stage", "Index", "Stage")</li>
                                            <li>@Html.ActionLink("Status", "Index", "Status")</li>
                                            <li>@Html.ActionLink("User", "Index", "User")</li>
                                            <li>@Html.ActionLink("Agency Employee", "Index", "Tpi")</li>
                                        </ul>
                                    </li>
                                    *@
                                </ul>
                            </nav>

                        </div>
                    </div>
                </div>
                <div class="canvas__open">
                    <span class="fa fa-bars"></span>
                </div>
            </div>
        </header>
  
    <div class="container">
        @RenderBody()
        <hr />
        <footer style="float:left">
            <p>&copy; @DateTime.Now.Year - L&T Special Steels and Heavy Forgings Pvt. Ltd. </p>
        </footer>
    </div>

