@model ICMS.Models.RequestPlannerDetailsViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h4>List of Planner</h4>

<p>
    <label style="color:green">@TempData["TransactionStatus"] </label>
    <label style="color:red">@TempData["RecordException"] </label>
    <label style="color:red">@ViewBag.RecordNotExist </label>
</p>
@using (Html.BeginForm("Create", "PlannerExternalRequest", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="form-group">
        <div>
            @if (Model.ListRequestPlannerDetails != null)
            {
                for (int i = 0; i < Model.ListRequestPlannerDetails.Count; i++)
                {
                    @Html.HiddenFor(x => x.ListRequestPlannerDetails[0].tempValue, new { Name = "tempValue" })
                }
            }
            <input type="submit" value="Group Selected Request" name="ClubRequest" id="btnClubRequest"
                   class="btn btn-primary btn-large" />
        </div>
    </div>
}

<table class="table table-striped">
    <tr>
        <th scope="col"><input type="checkbox" name="checkAll" id="checkAll" /></th>
        <th scope="col">Request</th>
        <th scope="col">Revision</th>
        <th scope="col">Project</th>
        <th scope="col">Forging No</th>
        <th scope="col">Stage</th>
        <th scope="col">Offer Date & Time</th>
        <th scope="col">Plan Start Date & Time</th>
        <th scope="col">Plan End Date & Time</th>
        <th scope="col">Department</th>
        <!--<th scope="col">PS Number</th>-->
        <th scope="col">Employee Name</th>
        <th scope="col">Status</th>
    </tr>
    @if (Model.ListRequestPlannerDetails != null)
    {
        for (int i = 0; i < Model.ListRequestPlannerDetails.Count; i++)
        {
<tr>
    <td scope="row">
        <input type="checkbox" name="checkRqID" value="@Model.ListRequestPlannerDetails[i].objInspReqModel[i].RqID"
               id="@Model.ListRequestPlannerDetails[i].objInspReqModel[i].RqNo" />
    </td>
    <td scope="row">@Model.ListRequestPlannerDetails[i].objInspReqModel[i].RqNo</td>
    <td scope="row">@Model.ListRequestPlannerDetails[i].objInspReqModel[i].RqRevNo</td>
    <td scope="row">@Model.ListRequestPlannerDetails[i].objInspReqModel[i].PrjNo</td>
    <td scope="row">@Model.ListRequestPlannerDetails[i].objInspReqModel[i].FrgNo</td>
    <td scope="row">@Model.ListRequestPlannerDetails[i].objInspReqModel[i].StageName</td>
    <td scope="row">@Model.ListRequestPlannerDetails[i].objInspReqModel[i].OfrDttm</td>
    <td scope="row">@Model.ListRequestPlannerDetails[i].objInspReqModel[i].PlanStartDateTime</td>
    <td scope="row">@Model.ListRequestPlannerDetails[i].objInspReqModel[i].PlanEndDateTime</td>
    <td scope="row">@Model.ListRequestPlannerDetails[i].objInspReqModel[i].RqDpcd</td>
    <!--<td scope="row">@Model.ListRequestPlannerDetails[i].objInspReqModel[i].EmployeeID</td>-->
    <td scope="row">@Model.ListRequestPlannerDetails[i].objInspReqModel[i].EmployeeName</td>
    <td scope="row">@Model.ListRequestPlannerDetails[i].objInspReqModel[i].RqStatus</td>
</tr>
        }
    }


</table>

@if (Model.pager.EndPage > 1)
{
    <ul class="pagination">
        <!--If Current page is not the First Page, we will show Button/Link to go First or on Previous page-->
        @if (Model.pager.CurrentPage > 1)
        {
            <li>
                @Html.ActionLink("First", "Index", new { id = 1 })
            </li>
            <li>
                @Html.ActionLink("Previous", "Index", new { id = Model.pager.CurrentPage - 1 })
            </li>
        }
        <!--Paging from StartPage to the end Page-->
        @for (var page = Model.pager.StartPage; page <= Model.pager.EndPage; page++)
        {
            <li class="@(page == Model.pager.CurrentPage ? "active" : "")">
                @Html.ActionLink((string)(page).ToString(), "Index", new { page = Model.pager.CurrentPage + 1 })
            </li>
        }
        <!--If Current Page is not the Last Page then show Next and Last Button/link on Paging-->
        @if (Model.pager.CurrentPage <= Model.pager.TotalPages)
        {
            <li>
                @Html.ActionLink("Next", "Index", new { page = Model.pager.CurrentPage + 1 })
            </li>
            <li>
                @Html.ActionLink("Last", "Index", new { page = Model.pager.TotalPages })
            </li>
        }
    </ul>
}
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            $("#btnClubRequest").click(function () {
                var RequestID = "";
                if (($('input[name="checkRqID"]:checked').length) < 1) {
                    alert('Please select atleast one request');
                    return false;
                }
                $('input[name="checkRqID"]:checked').each(function () {
                    RequestID = RequestID + this.value + ",";
                });
                document.getElementById('ListRequestPlannerDetails_0__tempValue').value = RequestID;
            });
            $("#checkAll").click(function () {
                $('input:checkbox').not(this).prop('checked', this.checked);
            });
        });
    </script>
}
