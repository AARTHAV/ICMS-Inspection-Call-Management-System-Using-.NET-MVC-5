@model ICMS.Models.LocMstModel

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div>
    <h4>Location details</h4>
    <div style="color:red">@ViewBag.RecordNotExist</div>
    <hr />
    @{
        if (@ViewBag.RecordNotExist == null)
        {
            <dl class="dl-horizontal">

                <dt>
                    @Html.DisplayNameFor(model => model.LcID)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.LcID)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.LcName)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.LcName)
                </dd>


                <dt>
                    @Html.DisplayNameFor(model => model.LcRegDttm)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.LcRegDttm)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.LcRegBy)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.LcRegBy)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.LcStatus)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.LcStatus)
                </dd>

            </dl>
        }
    }
</div>

<p>
    @if (@ViewBag.RecordNotExist == null)
    {
        @Html.ActionLink("Edit |", "Edit", new { id = Model.LcID })
    }
    @Html.ActionLink("Back to List", "Index")
</p>
