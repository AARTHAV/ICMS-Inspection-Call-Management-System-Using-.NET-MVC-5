                    }
                }

                /*$("#FrgNo").html(markup).show();*/
                $("#lstFrgNo").append(markup).show();
                $("#lstSelectdFrgNo").append(markupSelected).show();
            },
            error: function () {
                alert("Data Not Found");
            }
        });
    }

    function checkFileUploadExt(fieldObj) {
        var control = document.getElementById("UploadedFile");
        var filelength = control.files.length;

        for (var i = 0; i < control.files.length; i++) {
            var file = control.files[i];
            var FileName = file.name;
            var FileExt = FileName.substr(FileName.lastIndexOf('.') + 1);
            if ((FileExt.toUpperCase() != "PDF") && (FileExt.toUpperCase() != "XLS") && (FileExt.toUpperCase() != "XLSX")
                && (FileExt.toUpperCase() != "DOC") && (FileExt.toUpperCase() != "DOCX") && (FileExt.toUpperCase() != "DOCS") && (FileExt.toUpperCase() != "PNG")
                && (FileExt.toUpperCase() != "JPG") && (FileExt.toUpperCase() != "GIF")) {
                //.xls|.xlsx|.doc|.docx|.pdf|.png|.jpg|.gif)
                var error = "File type : " + FileExt + "\n\n";
                error += "Please make sure your file is in .xls|.xlsx|.doc|.docx|.pdf|.png|.jpg|.gif  format .\n\n";
                alert(error);
                document.getElementById("UploadedFile").value = "";
                return false;
            }
        }
    }

    function OnChangeStage(sel) {
        var x = sel.options[sel.selectedIndex].text;
        document.getElementById("StageName").value = x;
    }

    function addFrgNo() {

        var e = document.getElementById("lstFrgNo"), trend, i;
        var selectedValue = []
        for (i = 0; i < e.length; i++) {
            trend = e[i];
            if (trend.selected) {
                if (trend.value != "-Select Forging-") {
                    selectedValue.push(trend.value);
                    var Name_of_Employees = document.getElementById("lstSelectdFrgNo");
                    var option = document.createElement("OPTION");
                    option.innerHTML = trend.text;
                    option.value = trend.value;
                    Name_of_Employees.options.add(option);
                }
            }
        }
        for (var i = 0; i < selectedValue.length; i++) {
            for (var k = 0; k < e.length; k++) {
                if (e.options[k].value == selectedValue[i])
                    e.remove(k);
            }
        }
