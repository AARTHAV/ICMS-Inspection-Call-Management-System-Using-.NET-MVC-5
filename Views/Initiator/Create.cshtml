    function FillCity() {
        var stateId = $('#ProjectName').val();
        //var procemessage = "<option value=''> Please wait...</option>";
        //$("#FrgNo").html(procemessage).show();
        var hiddenFrgNo = document.getElementById('hiddenFrgNo').value;
        var str_array_hiddenFrgNo = hiddenFrgNo.split(',');


        $.ajax({
            url: '/ICMS/Initiator/GetForgingList',
            type: "GET",
            dataType: "JSON",
            data: { ProjectNo: stateId },
            success: function (data) {
                var markup = "<option disabled='disabled' value=''>-Select Forging-</option>";
                var markupSelected = "<option disabled='disabled' value=''>-Selected Forging-</option>";
                $("#lstFrgNo").html(""); // clear before appending new list
                $("#lstSelectdFrgNo").html("");
                if (hiddenFrgNo == "") {
                    $.each(data, function (i, item) {
                        if (hiddenFrgNo == "undefined" || hiddenFrgNo == "") {
                            markup += "<option value=" + data[i].Value + ">" +
                                data[i].Text + "</option>";
                        }
                        else {
                            markup += "<option value=" + data[i].Value + ">" +
                                data[i].Text + "</option>";
                        }

                    });

                    //$("#FrgNo").append($('<option></option>').text(data[i].Text).val(data[i].Value ));
                }
                else {
                    $.each(data, function (i, item) {

                        for (var k = 0; k < str_array_hiddenFrgNo.length; k++) {
                            // Trim the excess whitespace.
                            str_array_hiddenFrgNo[k] = str_array_hiddenFrgNo[k].replace(/^\s*/, "").replace(/\s*$/, "");
                            // Add additional code here, such as:
                            if (str_array_hiddenFrgNo[k] == data[i].Value) {
                                markupSelected += "<option selected value=" + data[i].Value + ">" +
                                    data[i].Text + "</option>";
                            }
                        }


                        //$("#FrgNo").append($('<option></option>').text(data[i].Text).val(data[i].Value ));
                    });
                    //var IsNeedToAdd = false;
                    //$.each(data, function (i, item) {
