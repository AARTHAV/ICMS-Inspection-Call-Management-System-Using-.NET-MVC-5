        //    e.remove(e.selectedIndex);
        //}

    }

    function removeFrgNo() {

        var e = document.getElementById("lstSelectdFrgNo"), trend, i;
        var selectedValue = []
        for (i = 0; i < e.length; i++) {
            trend = e[i];
            if (trend.selected) {
                if (trend.value != "-Selected Forging-") {
                    selectedValue.push(trend.value);
                    var Name_of_Employees = document.getElementById("lstFrgNo");
                    var option = document.createElement("OPTION");
                    option.innerHTML = trend.text;
                    option.value = trend.value;
                    Name_of_Employees.options.add(option);
                }
            }
        }
        for (var i = 0; i < selectedValue.length; i++) {
            for (var k = 0; k < e.length; k++) {
                if (e.options[k].value == selectedValue[i])
                    e.remove(k);
            }
        }

    }

    function CheckValidation() {
        if (!ValidateOfferDate()) {
            alert(` Please Raise Call Before 4 Hours `);
            return
        }

        var lstSelectdFrgNo = document.getElementById("lstSelectdFrgNo");
        if (lstSelectdFrgNo.length == "1") {
            alert("Please select Forgin.");
            return false;
        }
        var FrgNo = "";
        for (var i = 1; i < lstSelectdFrgNo.length; i++) {
            FrgNo = FrgNo + lstSelectdFrgNo[i].text + ",";
