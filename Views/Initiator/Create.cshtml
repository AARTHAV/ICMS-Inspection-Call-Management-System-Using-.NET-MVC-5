                    //            markup += "<option value=" + data[i].Value + ">" +
                    //                data[i].Text + "</option>";
                    //        }
                    //    }
                    //}
                    var dataLen = 0;
                    if (str_array_hiddenFrgNo.length == 1) {
                        dataLen = data.length;
                    }
                    else {
                        dataLen = data.length-1;
                    }
                    for (var i = 0; i < dataLen; i++) {
                        //$.each(data, function (i, item) {
                        for (var k = 0; k < 1; k++) {
                            str_array_hiddenFrgNo[k] = str_array_hiddenFrgNo[k].replace(/^\s*/, "").replace(/\s*$/, "");
                           
                            if (str_array_hiddenFrgNo[k] != data[i].Value) {
                                markup += "<option value=" + data[i].Value + ">" +
                                    data[i].Text + "</option>";
                                break;
