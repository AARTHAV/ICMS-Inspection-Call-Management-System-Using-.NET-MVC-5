@model ICMS.Models.InspReqModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Create Request";
}
<div class="form-horizontal">
    <h4>Raise Request</h4>
    <h4><div style="float:right;color:blue">Status:Draft</div></h4>
    @using (Html.BeginForm("Create", "Initiator", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div style="color:red">@ViewBag.RecordException</div>
        <div style="color:red">@TempData["RecordException"] @TempData["ExistingReqNo"] </div>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            <div>
                @Html.LabelFor(model => model.PrjNo, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-3">
                    @Html.DropDownListFor(model => model.ProjectName, new SelectList((List<SelectListItem>)Model.listProject,
                        "Value", "Text"), "Please Select", new { @class = "form-control", @onchange = "FillCity()" })
                    @* @Html.EditorFor(model => model.ProjectName, new { htmlAttributes = new { @onfocusout = "FillCity()", @class = "form-control" } })*@
                    @Html.ValidationMessageFor(model => model.ProjectName, "", new { @class = "text-danger" })
                    @*<input type="text" id="txtCustomer" name="CustomerName" class="form-control" />*@
                    <input type="hidden" id="hfCustomer" name="CustomerId" />
                    @*, @onchange = "FillCity()"*@
                </div>
            </div>
            <div>
                @*@Html.LabelFor(model => model.FrgNo, htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="col-md-3">
                    @*@Html.EditorFor(model => model.FrgNo, new { htmlAttributes = new { @class = "form-control" } })*@
                    @*@Html.DropDownListFor(model => model.FrgNo,
                          new SelectList(Enumerable.Empty<SelectListItem>(), "FrgNo", "ForgingInfo"),
                        new { @class = "form-control" })*@
                    <input type="hidden" name="hiddenFrgNo" id="hiddenFrgNo" value="@ViewBag.selectedForgNo" />
                    @*@Html.DropDownListFor("FrgNo", (IEnumerable<SelectListItem>)ViewBag.Forging, "Select Forging", new { @class = "form-control" })*@
                </div>
            </div>
        </div>
        <div class="form-group">

            <div>
                @Html.LabelFor(model => model.FrgNo, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    <div style="float:left">
                        @Html.ListBoxFor(model => model.lstFrgNo, new SelectList(Enumerable.Empty<SelectListItem>(), "FrgNo", "ForgingInfo"), new { @class = "listbox", @style = "width:250px" })
                    </div>
                    <div style="float:left">
                        <div>
                            <input type="button" value=">>" name="btnAddFrgNo" id="btnAddFrgNo" onclick="return addFrgNo()" />
                        </div>
                        <div>
                            <input type="button" value="<<" name="btnRemoveFrgNo" id="btnRemoveFrgNo" onclick="return removeFrgNo()" />
                        </div>

                    </div>
                </div>
                <div>
                    @Html.DropDownListFor(model => model.lstSelectdFrgNo, new SelectList(""), "--Selected Forging--", new { @size = 4, @class = "form-control;listbox", @multiple = "multiple", @style = "width:250px" })
                    @*<select id="Name_of_Employees" name="Name_of_Employees" Name="Name_of_Employees" Size="5"></select>*@
                    @*<input type="hidden" name="tempValue" id="tempValue"/>*@
                    @Html.HiddenFor(o => o.hiddenfieldSelectedFrgNo, new { Name = "hiddenfieldSelectedFrgNo" })
                </div>
            </div>
        </div>
        <div class="form-group">
            <div>
                @Html.LabelFor(model => model.StgID, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-3">
                    @*@Html.DropDownListFor(m => m.AgcyID, ViewBag.Agency as SelectList, new { @class = "form-control" })*@
                    @Html.DropDownList("StgID", (IEnumerable<SelectListItem>)ViewBag.stage, "Select Stage", new { @class = "form-control", onchange = "return OnChangeStage(this);" })
                    @Html.ValidationMessageFor(model => model.StgID, "", new { @class = "text-danger" })
                </div>

            </div>
            <div>
                @Html.LabelFor(model => model.LcID, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-3">
                    @*@Html.EditorFor(model => model.LcID, new { htmlAttributes = new { @class = "form-control" } })*@
                    @Html.DropDownList("LcID", (IEnumerable<SelectListItem>)ViewBag.location, "Select Location", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.LcID, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="form-group">
            <div>
                @Html.LabelFor(model => model.OfrDttm, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-3">
                    @Html.EditorFor(m => m.OfrDttm, "{0:dd/MM/yyyyTHH:mm}",
                    new { htmlAttributes = new { @Value = DateTime.Now.AddMinutes(245).ToString("yyyy-MM-ddTHH:mm"), type = "datetime-local", @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.OfrDttm, "", new { @class = "text-danger" })
                    @*<input name="OfrDttm" />*@
                </div>
            </div>
            <div>
                @Html.LabelFor(model => model.Remark, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-5">
                    @Html.EditorFor(model => model.Remark, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Remark, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <div>
                @Html.LabelFor(model => model.FilePath, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-3">
                    @*<input type="file" name="UploadedFile" multiple="multiple" />*@
                    @Html.TextBoxFor(model => model.UploadedFile, new
                    {
                        type = "file",
                        multiple = "multiple",
                                     onchange = "return checkFileUploadExt(this);"
                    })
                    @Html.ValidationMessageFor(m => m.UploadedFile, "", new { @class = "text-danger" })
                </div>
            </div>
            <div>
                @Html.LabelFor(model => model.RqRegBy, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-3">
                    @Html.EditorFor(model => model.RqRegBy, new { htmlAttributes = new { @Value = @Session["EmpName"].ToString(), @readonly = "readonly", @class = "form-control" } })
                </div>
            </div>

        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.RqOts, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.CheckBoxFor(model => model.RqOts, new { htmlAttributes = new { @checked = "checked", @class = "form-control" } })

                <b>I am confirming that previous stage(s) in OTS are closed</b>
                @*@Html.ValidationMessageFor(model => model.RqOts)*@
            </div>
        </div>
        <div class="form-group" style="visibility:hidden">
            <div>
                @*<input type="hidden" id="StageName" name="StageName" value="@Model.StageName"/>*@
                @Html.EditorFor(model => model.StageName, new { htmlAttributes = new { id = "StageName", @class = "form-control" } })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                @*<input type="submit" value="Save" name="Draft" class="btn btn-primary btn-large" />*@
                <input type="submit" value="Submit" name="Submitted" class="btn btn-primary btn-large" onclick="return CheckValidation(); " />
                @*<input type="button" value="Submit 1" name="Submitted" class="btn btn-primary btn-large" onclick="return CheckValidation();" />*@
                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-primary btn-large" })
            </div>
        </div>
    }
</div>


<div>
    @*@Html.ActionLink("Back to List", "Index")*@
</div>

@section Scripts {

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")

    <script src="~/js/jquery-ui.js"></script>
    <link href="~/js/jquery-ui.css" rel="Stylesheet"></link>
    <style type="text/css">

        .ui-autocomplete {
            max-height: 500px;
        }

        .ui-menu .ui-menu-divider {
            margin: 30px 0;
            height: 0;
            font-size: 0;
            line-height: 0;
            border-width: 1px 0 0 0;
            color: black;
        }

        .ui-widget-content {
            color: black;
            font-display: block;
        }

        .ui-autocomplete {
            /*background: rgba(0, 0, 0, 1);*/
            border: 0px;
            border-radius: 2px;
            position: absolute;
            left: 50%;
            margin-left: -336px;
            display: none;
