            }

            .ui-autocomplete .ui-menu-item .ui-state-focus {
                background: none;
                border: 0px;
            }
    </style>

    <script>
        $(document).ready(function () {
            var d = new Date();
            var hours = d.getHours() % 12;
            hours = hours < 10 ? "0" + hours : hours;
            var ampm = hours >= 12 ? 'pm' : 'am';
            elem = document.getElementById("OfrDttm")
            var iso = new Date().toISOString();
            var minDate = iso.substring(0, iso.length - 14);
            var minutes = d.getMinutes() < 10 ? "0" + d.getMinutes() : d.getMinutes();
            var seconds = d.getSeconds() < 10 ? "0" + d.getSeconds() : d.getSeconds();
            //elem.min = minDate + 'T00:00:00'
            elem.min = minDate + 'T' + hours + ':' + minutes + ':' + seconds;
            var PrjectNo = document.getElementById('ProjectName').value;

            if (PrjectNo != "") {
                FillCity();
            }
            $(function () {
                $("#ProjectName1").autocomplete({
                    source: function (request, response) {
                        $.ajax({
                            url: '/ICMS/Initiator/AutoComplete/',
                            data: "{ 'prefix': '" + request.term + "'}",
                            dataType: "json",
                            type: "POST",
                            contentType: "application/json; charset=utf-8",
                            success: function (data) {
                                response($.map(data, function (item) {
                                    return item.Text;
                                }))
                            },
                            error: function (response) {
                                //alert(response.responseText);
                                alert(response.responseText);
                            },
                            failure: function (response) {
                                alert(response.responseText);
                            }
                        });
                    },
                    select: function (e, i) {
                        $("#hfCustomer").val(i.item.val);
                    },
                    minLength: 0
                }).focus(function () {
                    $(this).autocomplete("search");
                });
            });

            $('#OfrDttm').change(function () {

                if (!ValidateOfferDate()) {
                  alert(` Please raise call before 4 hours`)
                }
            })
        });

        function ValidateOfferDate() {
            let diff = new Date($('#OfrDttm').val()) - new Date();
            let minutes = diff / 1000 / 60;
            if (minutes < 240) {
                return false;
            }
            else {
                return true;
            }
        }
    </script>
}
