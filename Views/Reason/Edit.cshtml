@model ICMS.Models.ReasonMstModel

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
<div class="form-horizontal">
    <h4>Edit Reason</h4>
    <div style="color:red">
        @ViewBag.RecordNotExist
        @ViewBag.RecordException
    </div>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(model => model.RsnID, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.RsnID, new { htmlAttributes = new { @readonly = "readonly", @class = "form-control" } })
        </div>
    </div>


    <div class="form-group">
        @Html.LabelFor(model => model.RsnDesc, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.RsnDesc, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.RsnDesc, "", new { @class = "text-danger" })
        </div>
    </div>


    <div class="form-group">
        @Html.LabelFor(model => model.RsnRegBy, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.RsnRegBy, new { htmlAttributes = new { @readonly = "readonly", @Value = Session["EmpName"].ToString(), @class = "form-control" } })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.RsnStatus, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-3">
            @Html.DropDownListFor(model => model.RsnStatus,
                    new SelectList(new List<SelectListItem> {
                             new SelectListItem { Text = "Yes", Value = "1"},
                             new SelectListItem { Text = "No", Value = "0"}
                         }, "Value", "Text"),
                    "Select status",
                     new { @class = "form-control", style = "width:30%" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.IsReqiredFileUpload, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-3">
            @Html.DropDownListFor(model => model.IsReqiredFileUpload,
                    new SelectList(new List<SelectListItem> {
                             new SelectListItem { Text = "Yes", Value = "True"},
                             new SelectListItem { Text = "No", Value = "False"}
                         }, "Value", "Text"),
                    "Select File Required",
                     new { @class = "form-control", style = "width:90%" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Save" class="btn btn-default" />
        </div>
    </div>
</div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
